# Every setting is optional; the values shown are the defaults.
# Settings are read once at startup. Restart the process to apply a change.

# prod (default) | demo | eval. demo/eval load the adversarial overlay and expose security endpoints.
LEGISQA_PROFILE=prod
LEGISQA_DATA_DIR=sample-data
LEGISQA_VAR_DIR=var
LEGISQA_HOST=127.0.0.1
LEGISQA_PORT=8000
LEGISQA_LOG_LEVEL=INFO
LEGISQA_MIN_QUESTION_CHARS=3
LEGISQA_MAX_QUESTION_CHARS=500
LEGISQA_TOP_K=5
# Answerability gate. Development defaults; the operating point is tuned on the dev split only.
LEGISQA_GATE_MIN_STRENGTH=0.3
LEGISQA_GATE_MIN_MARGIN=0.0
LEGISQA_MAX_EXCERPT_SENTENCES=2
LEGISQA_FRONTEND_DIST=frontend/dist
